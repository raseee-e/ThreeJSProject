{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bodybuilding-stage": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/bodybuilding-stage",
            "index": "index.html",
            "main": "src/main.ts",
            "pollings": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "favicon.ico",
              "assets"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "bodybuilding-stage:build:production"
            },
            "development": {
              "browserTarget": "bodybuilding-stage:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
